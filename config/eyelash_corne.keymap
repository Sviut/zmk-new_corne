#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    hold-trigger-on-release;
    flavor = "balanced";
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ALPHA {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F      &kp P     &kp B                       &trans          &kp J      &kp L      &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp ESC    &kp A  &kp R  &kp S      &kp T     &kp G               &trans  &trans  &trans  &kp M      &kp N      &kp E      &kp I    &kp O     &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp C      &kp D     &kp V     &trans            &trans          &kp K      &kp H      &kp COMMA  &kp DOT  &kp FSLH  &trans
                         &kp LCTRL  &kp LGUI  &kp LALT                                    &kp SPACE  &kp ENTER  &kp DEL
            >;
        };

        NAV {
            bindings = <
&trans  &trans        &trans    &trans     &trans          &trans                    &trans          &trans  &trans    &kp UP    &trans     &trans  &trans
&trans  &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LEFT_SHIFT  &trans            &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans        &trans    &trans     &trans          &trans  &trans            &trans          &trans  &trans    &trans    &trans     &trans  &trans
                                &trans     &trans          &trans                                    &trans  &trans    &trans
            >;
        };
    };
};
