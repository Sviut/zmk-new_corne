#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYM  1
#define NAV  2

// ─── Mod-tap: используется только для ESC/LALT на большом пальце ─────────────
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    hold-trigger-on-release;
    flavor = "balanced";
};

// ─── Layer-tap: SPACE→SYM и ENTER→NAV ────────────────────────────────────────
&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "tap-preferred";  // быстрый тап всегда даёт символ, не слой
};

&soft_off { hold-time-ms = <2000>; };

/ {
    combos {
        compatible = "zmk,combos";

        // Зажать три клавиши 2 сек — выключить клавиатуру
        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ═══════════════════════════════════════════════════════════════════
        // СЛОЙ 0: BASE — QWERTY
        // Модификаторы на крайних колонках, как на обычной клаве.
        // Русский язык — переключается в ОС, ZMK ничего не делает.
        //
        // ┌────────┬───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┬──────┐
        // │  TAB   │ Q │ W │ E │ R │ T │   │ Y │ U │ I │ O │ P │ BSPC │
        // ├────────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼──────┤
        // │ LCTRL  │ A │ S │ D │ F │ G │   │ H │ J │ K │ L │ ; │  '   │
        // ├────────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼──────┤
        // │ LSHIFT │ Z │ X │ C │ V │ B │   │ N │ M │ , │ . │ / │ ENT  │
        // └────────┴───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┴──────┘
        //              ┌──────────┬──────┬───────────┐   ┌───────────┬──────┬─────┐
        //              │ ESC/LALT │ LGUI │ SPC / SYM │   │ ENT / NAV │ BSPC │ DEL │
        //              └──────────┴──────┴───────────┘   └───────────┴──────┴─────┘
        // ═══════════════════════════════════════════════════════════════════
        BASE {
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E  &kp R  &kp T                      &trans          &kp Y  &kp U    &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL   &kp A  &kp S  &kp D  &kp F  &kp G              &trans  &trans  &trans  &kp H  &kp J    &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z  &kp X  &kp C  &kp V  &kp B    &trans            &trans          &kp N  &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp ENTER
                       &mt LALT ESC  &kp LGUI  &lt SYM SPACE                        &lt NAV ENTER  &kp BSPC  &kp DEL
            >;
        };

        // ═══════════════════════════════════════════════════════════════════
        // СЛОЙ 1: SYM — символы + цифры (держать SPACE)
        // Левая рука: символы для кода (Rust/Go).
        // Правая рука: numpad (7-8-9 / 4-5-6 / 1-2-3).
        //
        // ┌─────┬───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┬─────┐
        // │ ESC │ ! │ @ │ # │ $ │ % │   │ ^ │ 7 │ 8 │ 9 │ ( │  )  │
        // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
        // │     │ _ │ + │ { │ } │ | │   │ * │ 4 │ 5 │ 6 │ - │ ENT │
        // ├─────┼───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┼─────┤
        // │     │ ` │ = │ [ │ ] │ \ │   │ / │ 1 │ 2 │ 3 │ 0 │ END │
        // └─────┴───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┴─────┘
        //              ┌─────┬─────┬─────┐   ┌─────┬─────┬─────┐
        //              │     │     │ ███ │   │     │     │     │
        //              └─────┴─────┴─────┘   └─────┴─────┴─────┘
        // Подсказки Rust: _ (snake_case), {} (блоки), | (замыкания |x|),
        //                 `  (строки в Go), SHIFT+` = ~
        // ═══════════════════════════════════════════════════════════════════
        SYM {
            bindings = <
&kp ESC  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                  &trans          &kp CARET  &kp N7  &kp N8  &kp N9  &kp LPAR   &kp RPAR
&trans   &kp UNDER  &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE           &trans  &trans  &trans  &kp STAR   &kp N4  &kp N5  &kp N6  &kp MINUS  &kp ENTER
&trans   &kp GRAVE  &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH &trans            &trans          &kp FSLH   &kp N1  &kp N2  &kp N3  &kp N0     &kp END
                               &trans   &trans     &trans                                      &trans     &trans  &trans
            >;
        };

        // ═══════════════════════════════════════════════════════════════════
        // СЛОЙ 2: NAV — навигация + F-клавиши (держать ENTER)
        // Правая рука: стрелки VIM-style (H=←, J=↓, K=↑, L=→).
        // Левая рука: медиа-клавиши и Bluetooth.
        //
        // ┌────┬────┬────┬─────┬─────┬──────┐   ┌─────┬──────┬──────┬──────┬─────┬─────┐
        // │ F1 │ F2 │ F3 │ F4  │ F5  │  F6  │   │ F7  │  F8  │  F9  │ F10  │ F11 │ F12 │
        // ├────┼────┼────┼─────┼─────┼──────┤   ├─────┼──────┼──────┼──────┼─────┼─────┤
        // │    │ ⏮  │ ⏭  │ VOL-│ VOL+│ PLAY │   │HOME │  ←   │  ↓   │  ↑   │  →  │ END │
        // ├────┼────┼────┼─────┼─────┼──────┤   ├─────┼──────┼──────┼──────┼─────┼─────┤
        // │    │BCLR│BNXT│BPRV │     │      │   │PGDN │      │      │      │     │PGUP │
        // └────┴────┴────┴─────┴─────┴──────┘   └─────┴──────┴──────┴──────┴─────┴─────┘
        //              ┌─────┬─────┬───────┐   ┌─────┬──────┬─────┐
        //              │     │     │ SPACE │   │ ███ │ BSPC │ DEL │
        //              └─────┴─────┴───────┘   └─────┴──────┴─────┘
        // ═══════════════════════════════════════════════════════════════════
        NAV {
            bindings = <
&kp F1  &kp F2      &kp F3      &kp F4        &kp F5        &kp F6                     &trans          &kp F7    &kp F8    &kp F9    &kp F10   &kp F11    &kp F12
&trans  &kp C_PREV  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP           &trans  &trans  &trans  &kp HOME  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp END
&trans  &bt BT_CLR  &bt BT_NXT  &bt BT_PRV    &trans        &trans   &trans             &trans          &kp PG_DN &trans    &trans    &trans    &trans     &kp PG_UP
                                &trans        &trans         &kp SPACE                                   &trans    &kp BSPC  &kp DEL
            >;
        };
    };
};
