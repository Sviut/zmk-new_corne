#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    hold-trigger-on-release;
    flavor = "balanced";
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ALPHA {
            bindings = <
&none  &kp Q           &kp W           &kp F        &kp P        &kp B                      &trans          &kp J      &kp L          &kp U        &kp Y       &kp SEMI    &none
&none  &mt LEFT_GUI A  &mt LEFT_ALT R  &mt LCTRL S  &mt LSHFT T  &kp G              &trans  &trans  &trans  &kp M      &mt RSHFT N    &mt RCTRL E  &mt RALT I  &mt RGUI O  &none
&none  &kp Z           &kp X           &kp C        &kp D        &kp V    &trans            &trans          &kp K      &kp H          &kp COMMA    &kp DOT     &kp FSLH    &none
                                       &kp ESCAPE   &lt 1 SPACE  &kp TAB                                    &kp ENTER  &kp BACKSPACE  &kp DEL
            >;
        };

        NAV {
            bindings = <
&trans  &trans        &trans    &trans     &trans          &trans                    &trans          &kt RG(Z)  &kt LG(V)  &kp LG(C)  &kt LG(X)     &kt LG(LS(Z))    &trans
&trans  &kp LEFT_GUI  &kp LALT  &kp LCTRL  &kp LEFT_SHIFT  &trans            &trans  &trans  &trans  &kp CLCK   &kp LEFT   &kp DOWN   &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans        &trans    &trans     &trans          &trans  &trans            &trans          &trans     &trans     &trans     &trans        &trans           &trans
                                &trans     &trans          &trans                                    &trans     &trans     &trans
            >;
        };
    };
};
